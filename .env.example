# Salin jadi `.env` lalu ganti nilainya:  cp .env.example .env
DB_ROOT_PASSWORD=ganti_root_password
DB_PASSWORD=ganti_password_app

# Port di host (default 8090)
APP_PORT=8090

# 127.0.0.1 = hanya lokal / di belakang reverse proxy (disarankan di VPS)
# 0.0.0.0   = bisa diakses langsung dari internet lewat http://IP-VPS:APP_PORT
BIND_ADDR=127.0.0.1
